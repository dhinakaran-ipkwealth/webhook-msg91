{
  "name": "webhook-msg91-backend",
  "version": "1.0.0",
  "description": "MSG91 Webhook Backend Server",
  "main": "webhook-server.js",
  "scripts": {
    "start": "node webhook-server.js",
    "dev": "node --watch webhook-server.js",
    "dev:local": "node --watch scripts/dev-local.js",
    "build": "node scripts/build.js",
    "pm2:start": "npm run build && pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "npm run build && pm2 restart ecosystem.config.js --env production",
    "pm2:reload": "npm run build && pm2 reload ecosystem.config.js --env production",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:status": "pm2 status webhook-msg91-backend",
    "pm2:logs": "pm2 logs webhook-msg91-backend",
    "pm2:startup": "pm2 startup",
    "pm2:save": "pm2 save",
    "seed:senders": "node scripts/seed-sender-numbers.js"
  },
  "dependencies": {
    "axios": "^1.17.0",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "ioredis": "^5.6.0",
    "mongodb": "^6.12.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.10",
    "rate-limit-redis": "^4.2.0",
    "xlsx": "^0.18.5",
    "pm2": "^7.0.1"
  }
}
