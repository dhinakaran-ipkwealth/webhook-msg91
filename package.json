{
  "name": "ipk-webhook-msg91",
  "version": "0.1.3",
  "description": "IPK Wealth Communications Desktop App",
  "main": "main_mongodb_no_report_sync.js",
  "author": "IPK Wealth",
  "private": true,
  "scripts": {
    "start": "electron .",
    "electron": "electron .",
    "validate": "node validate.js",
    "logs": "node show-logs.js",
    "pack": "electron-builder --dir",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis"
  },
  "dependencies": {
    "axios": "^1.17.0",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "ioredis": "^5.11.1",
    "mongodb": "^6.12.0",
    "nodemailer": "^8.0.10",
    "rate-limit-redis": "^4.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ipk.communications",
    "productName": "IPK Wealth Communications",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main_mongodb_no_report_sync.js",
      "index_modern_saas_complete.html",
      "renderer.js",
      "preload.js",
      "validate.js",
      "msg91.config.json",
      ".env",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/webhook_msg91_512.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "asar": false
  }
}
